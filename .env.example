# Public/control server
AAAS_HOST=127.0.0.1
AAAS_PORT=8787
AAAS_DATA_DIR=.aaas
# Protect publishing and local source discovery.
AAAS_ADMIN_TOKEN=replace-with-a-long-random-token
# Optional consumer token. Leave unset for a public Agent service.
AAAS_API_TOKEN=

# Shared only between a trusted control plane and runner.
AAAS_RUNNER_TOKEN=replace-with-a-different-long-random-token

# Optional binary overrides.
AAAS_CLAUDE_BIN=claude
AAAS_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex

# Read-only is the safe default for public consumers.
AAAS_CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob
