{
  "name": "@efflora/aaas",
  "version": "0.2.1",
  "description": "Turn a Codex or Claude Code session into an Agent anyone can use, with a private conversation for every recipient.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Efflora contributors",
  "keywords": [
    "agent",
    "agent-as-a-service",
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "session-fork"
  ],
  "bin": {
    "aaas": "scripts/aaas.mjs"
  },
  "files": [
    "install.sh",
    "scripts",
    "skills",
    "src",
    "README.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Equality-Machine/agent-as-a-service.git"
  },
  "homepage": "https://aaas-agent-service.b4yesc4t.chatgpt.site",
  "bugs": {
    "url": "https://github.com/Equality-Machine/agent-as-a-service/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node src/cli.mjs serve",
    "start": "node src/cli.mjs serve",
    "runner": "node src/cli.mjs runner",
    "mcp": "node src/mcp-stdio.mjs",
    "cloud:mcp": "node src/aaas-mcp-stdio.mjs",
    "cloud:runner": "node src/cloud-runner-cli.mjs",
    "cloud:enroll": "node src/enroll-runner-cli.mjs",
    "publish": "node src/publish-cli.mjs",
    "install:clients": "node scripts/install.mjs",
    "install:runner": "node scripts/install-runner.mjs",
    "test": "node --test tests/*.test.mjs tests/e2e/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "package:check": "npm pack --dry-run --json",
    "check": "npm test && npm run docs:check && npm run package:check && npm --prefix cloud test && npm --prefix cloud run lint"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.4"
}
